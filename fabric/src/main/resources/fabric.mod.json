{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"Bananemdnsa",
		"PixlStudios"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/history-stages",
		"sources": "https://github.com/Flix100000/History-Stages",
		"issues": "https://github.com/Flix100000/History-Stages/issues",
		"wiki": "https://historystages.github.io/"
	},
	"license": "${mod_license}",
	"icon": "assets/historystages/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.bananemdnsa.historystages.fabric.HistoryStagesFabric"
		],
		"client": [
			"net.bananemdnsa.historystages.fabric.HistoryStagesFabricClient"
		],
		"fabric-gametest": [
			"net.bananemdnsa.historystages.fabric.gametest.BridgeCancelTests",
			"net.bananemdnsa.historystages.fabric.gametest.BridgeMixinTests",
			"net.bananemdnsa.historystages.fabric.gametest.BridgePriorityTests",
			"net.bananemdnsa.historystages.fabric.gametest.AddonRegistrationTests",
			"net.bananemdnsa.historystages.fabric.gametest.PedestalTransferTests",
			"net.bananemdnsa.historystages.fabric.gametest.DisguiseBreakTests",
			"net.bananemdnsa.historystages.fabric.gametest.InteractionClassifyTests",
			"net.bananemdnsa.historystages.fabric.gametest.RecipeOutputTests",
			"net.bananemdnsa.historystages.fabric.gametest.PayloadSizeTests",
			"net.bananemdnsa.historystages.fabric.gametest.RecipeListSyncTests"
		],
		"historystages": [
			"net.bananemdnsa.historystages.fabric.gametest.TestAddonPlugin"
		],
		"jei_mod_plugin": [
			"net.bananemdnsa.historystages.compat.jei.JEIPlugin"
		],
		"jade": [
			"net.bananemdnsa.historystages.compat.jade.JadePlugin"
		]
	},
	"mixins": [
		"historystages.mixins.json",
		"historystages-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": ">=${minecraft_version} <26.3",
		"java": ">=25",
		"fabric-api": "*",
		"architectury": ">=21.1",
		"lootr": ">=1.23.38.112"
	},
	"suggests": {
		"jade": ">=26.2 <26.3",
		"jei": ">=30 <31",
		"spell_engine": ">=1.9",
		"bettercombat": ">=1"
	}
}
